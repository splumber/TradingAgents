# Alpha Vantage API (Required for market data)
ALPHA_VANTAGE_API_KEY=alpha_vantage_api_key_placeholder

# Cloud LLM Provider API Keys (Choose one based on your provider)
# For OpenAI
OPENAI_API_KEY=openai_api_key_placeholder

# For Anthropic Claude
# ANTHROPIC_API_KEY=anthropic_api_key_placeholder

# For Google Gemini
# GOOGLE_API_KEY=google_api_key_placeholder

# For OpenRouter
# OPENROUTER_API_KEY=openrouter_api_key_placeholder

# For Local LLMs via Ollama - No API key needed!
# Just install Ollama (https://ollama.ai) and pull models:
# ollama pull llama3.2
# ollama pull llama3.1
# ollama pull nomic-embed-text
# Then select "Ollama" as provider in CLI or set:
# config["llm_provider"] = "ollama"
# config["backend_url"] = "http://localhost:11434/v1"